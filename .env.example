# =============================================================================
# .env.example — Mẫu biến môi trường (KHÔNG chứa giá trị thật)
#
# Cách dùng:
#   1. Sao chép tệp này thành `.env` tại thư mục gốc dự án.
#   2. Điền giá trị thật cho từng biến bên dưới.
#   3. TUYỆT ĐỐI KHÔNG commit tệp `.env` lên Git (đã được .gitignore chặn).
#
# Trên máy chủ production, tệp `.env` được giữ cố định và KHÔNG bị git pull ghi đè.
# Các script `run-upgrade.js` và `scripts/remote_deploy.py` tự động sao lưu/phục hồi
# `.env` quanh thao tác git pull để bảo toàn cấu hình thật.
# =============================================================================

# --- 1. Super Admin (/he-thong) ---------------------------------------------
# Tài khoản tối cao quản trị toàn hệ thống. Chỉ chủ hệ thống nắm giữ.
SYSTEM_ADMIN_USERNAME=hethong
SYSTEM_ADMIN_PASSWORD=doi_mat_khau_manh_tren_12_ky_tu
# Khóa bí mật dùng ký/xác thực token phiên Super Admin (chuỗi entropy cao)
SYSTEM_ADMIN_SECRET=chuoi_bi_mat_ngau_nhien_toi_thieu_32_ky_tu

# --- 2. Ký token phiên School Admin (HMAC-SHA256) ---------------------------
# Dùng để ký token đăng nhập của Quản trị cơ sở. Nếu để trống sẽ fallback về
# SYSTEM_ADMIN_SECRET. Khuyến nghị đặt riêng một chuỗi ngẫu nhiên khác.
SESSION_SECRET=

# --- 3. Chế độ nghiêm ngặt token --------------------------------------------
# "on"  = chỉ chấp nhận token đã ký (buộc mọi phiên cũ đăng nhập lại).
# ""    = chấp nhận cả token cũ chưa ký (tương thích ngược khi nâng cấp).
SESSION_STRICT=

# --- 4. Localhost Guard cho /he-thong ---------------------------------------
# "off" = tắt hoàn toàn guard (dùng khi cần truy cập qua SSH tunnel).
# ""    = bật (mặc định): chỉ loopback được vào /he-thong.
HETHONG_GUARD=
# Danh sách IP bổ sung được phép vào /he-thong, phân tách bằng dấu phẩy.
HETHONG_ALLOWED_IPS=

# --- 5. Môi trường chạy ------------------------------------------------------
# development | production
NODE_ENV=production
